<h1>Combobox</h1>
<p>The <code>&lt;gcds-ext-mws-combobox&gt;</code> is a custom element that provides a dropdown list of options for the user to select from.</p>

<h2>Default</h2>
<gcds-ext-mws-combobox
    label="Vegetable(s)"
    name="vegetables-combobox"
    input-id="vegetables-combobox"
    options='[{"cucumber": "Cucumber"},{"carrot": "Carrot"},{"broccoli": "Broccoli"},{"spinach": "Baby Spinach"}]'
>
</gcds-ext-mws-combobox>
<gcds-details details-title="Code sample">
    {% highlight "html" %}
    <gcds-ext-mws-combobox
    label="Vegetable(s)"
    name="vegetables-combobox"
    input-id="vegetables-combobox"
    options='[{"cucumber": "Cucumber"},{"carrot": "Carrot"},{"broccoli": "Broccoli"},{"spinach": "Baby Spinach"}]'
>
</gcds-ext-mws-combobox>
    {% endhighlight %}
</gcds-details>

<h2>Using Slots</h2>
<gcds-ext-mws-combobox
    label="Fruit(s)"
    name="fruits-combobox"
    input-id="fruits-combobox"
>
    <select slot="options">
        <option value="apple">Apple</option>
        <option value="banana">Banana</option>
        <option value="orange">Orange</option>
        <option value="grape">Grape</option>
    </select>
</gcds-ext-mws-combobox>

<gcds-details details-title="Code sample">
    {% highlight "html" %}
    <gcds-ext-mws-combobox
    label="Fruit(s)"
    name="fruits-combobox"
    input-id="fruits-combobox"
>
    <select slot="options">
        <option value="apple">Apple</option>
        <option value="banana">Banana</option>
        <option value="orange">Orange</option>
        <option value="grape">Grape</option>
    </select>
</gcds-ext-mws-combobox>
{% endhighlight %}
</gcds-details>

<h2>With hint and select all</h2>
<gcds-ext-mws-combobox
    label="Animal(s)"
    name="animals-combobox"
    input-id="animals-combobox"
    options='[{"lion": "Lion"},{"elephant": "Elephant"},{"giraffe": "Giraffe"},{"zebra": "Zebra"}]'
    enable-select-all
    hint="Select at least one animal."
>
</gcds-ext-mws-combobox>
<gcds-details details-title="Code sample">
    {% highlight "html" %}
    <gcds-ext-mws-combobox
    label="Animal(s)"
    name="animals-combobox"
    input-id="animals-combobox"
    options='[{"lion": "Lion"},{"elephant": "Elephant"},{"giraffe": "Giraffe"},{"zebra": "Zebra"}]'
    enable-select-all
    hint="Select at least one animal."
    required
>
</gcds-ext-mws-combobox>
{% endhighlight %}
</gcds-details>

<h2>Inside a form, required</h2>
<form novalidate action="#">
    <gcds-error-summary listen></gcds-error-summary>
    <gcds-ext-mws-combobox
        label="Animal(s)"
        name="animals-combobox"
        input-id="animals-combobox"
        options='[{"lion": "Lion"},{"elephant": "Elephant"},{"giraffe": "Giraffe"},{"zebra": "Zebra"}]'
        hint="Select at least one animal."
        required
    ></gcds-ext-mws-combobox>
    <gcds-button type="submit"> Submit </gcds-button>
</form>
